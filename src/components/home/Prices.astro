---
import { extras, minutes, rub, serviceById, type ServiceId } from '../../data/services';

const groups: { title: string; ids: ServiceId[] }[] = [
  { title: 'Руки', ids: ['manicure', 'gel', 'strength', 'removal'] },
  { title: 'Ноги', ids: ['pedicure', 'pedicure-gel'] },
];
---

<section id="ceny" class="section band-nude prices" aria-labelledby="ceny-title">
  <div class="container">
    <div class="section__head">
      <h2 id="ceny-title" class="h2">Цены</h2>
      <p class="lead">Цена в прайсе та, что вы заплатите. Если из-за длины или дизайна выйдет дороже, мастер скажет до начала работы, а не на кассе.</p>
    </div>

    <div class="prices__grid">
      {groups.map((g) => (
        <div class="plist">
          <h3 class="plist__title">{g.title}</h3>
          <ul>
            {g.ids.map((id) => {
              const s = serviceById(id)!;
              return (
                <li class="prow">
                  <div>
                    <p class="prow__name">{s.name}</p>
                    <p class="prow__inc small">{s.includes}</p>
                  </div>
                  <p class="prow__time small num">{minutes(s.duration)}</p>
                  <p class="prow__price num">{rub(s.price)}</p>
                </li>
              );
            })}
          </ul>
        </div>
      ))}

      <div class="plist plist--extras">
        <h3 class="plist__title">Доплаты, о которых лучше знать заранее</h3>
        <ul>
          {extras.map((x) => (
            <li class="prow prow--extra">
              <div>
                <p class="prow__name">{x.name}</p>
                {x.note && <p class="prow__inc small">{x.note}</p>}
              </div>
              <p class="prow__price num">{x.price}</p>
            </li>
          ))}
        </ul>
        <p class="small prices__note">Других доплат нет. Оплата картой, наличными или по СБП после процедуры.</p>
      </div>
    </div>

    <div class="prices__cta">
      <a class="btn btn--primary" href="#zapis">Записаться</a>
      <a href="#vybor">Помочь с выбором услуги</a>
    </div>
  </div>
</section>

<style>
  .prices__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem clamp(2rem, 1rem + 4vw, 5rem); }
  .plist ul { margin: 0; padding: 0; list-style: none; }
  .plist--extras { grid-column: 1 / -1; }
  .plist--extras ul { columns: 2; column-gap: clamp(2rem, 1rem + 4vw, 5rem); }
  .plist__title { font-size: var(--step-2); padding-bottom: 0.75rem; border-bottom: 2px solid var(--plum); }
  .prow {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }
  .prow--extra { grid-template-columns: 1fr auto; }
  .prow__name { font-weight: 650; }
  .prow__inc { color: var(--ink-2); margin-top: 0.15rem; }
  .prow__time { color: var(--ink-2); white-space: nowrap; }
  .prow__price { font-weight: 700; font-size: var(--step-1); white-space: nowrap; }
  .prices__note { margin-top: 1rem; color: var(--ink-2); }
  .prices__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.5rem; font-weight: 600; }

  @media (max-width: 860px) {
    .prices__grid { grid-template-columns: 1fr; }
    .plist--extras ul { columns: 1; }
  }
  @media (max-width: 480px) {
    /* On a phone the time moves under the name, so the price column stays aligned. */
    .prow { grid-template-columns: 1fr auto; }
    .prow__time { grid-column: 1; grid-row: 2; }
    .prow__price { grid-column: 2; grid-row: 1; }
  }
</style>

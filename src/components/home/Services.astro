---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { photo } from '../../data/photos';
import { minutes, rub, services } from '../../data/services';

const featured = services.filter((s) => s.featured);
const sizes = '(max-width: 900px) 28vw, 34vw';
---

<section id="uslugi" class="section services" aria-labelledby="uslugi-title">
  <div class="container services__grid">
    <div class="services__aside">
      <div class="section__head">
        <h2 id="uslugi-title" class="h2">Что можно сделать</h2>
        <p class="lead">Пять услуг, из которых складывается почти любая запись. Под каждой сказано, что входит и сколько это стоит.</p>
      </div>
      <div class="services__stage" aria-hidden="true">
        {featured.map((s, i) => (
          <Picture src={photo(s.photo)} alt="" formats={['avif', 'webp']} widths={[480, 720, 960]} sizes={sizes} loading="lazy" class:list={['services__photo', i === 0 && 'is-active']} data-stage={s.id} />
        ))}
      </div>
    </div>

    <ol class="services__list">
      {featured.map((s, i) => (
        <li class:list={['svc', i === 0 && 'is-active']} data-svc={s.id}>
          <Picture src={photo(s.photo)} alt="" formats={['avif', 'webp']} widths={[240, 360]} sizes="96px" loading="lazy" class="svc__thumb" />
          <div class="svc__body">
            <h3 class="svc__name">
              {s.name}
              {s.id === 'gel' && <span class="svc__tag">Чаще всего</span>}
            </h3>
            <p class="svc__plain">{s.plain}</p>
            <p class="svc__includes small">{s.includes}</p>
          </div>
          <div class="svc__meta">
            <p class="svc__price num">{s.priceLabel ?? rub(s.price)}</p>
            <p class="svc__time small"><Icon name="clock" />{s.addon ? `+${minutes(s.duration)}` : minutes(s.duration)}</p>
            <a class="btn btn--ghost btn--small svc__book" href="#zapis" data-book={s.id}>
              {s.addon ? 'Добавить к записи' : 'Выбрать'}<span class="visually-hidden">: {s.name}</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="container services__after">
    <a href="#ceny">Полный прайс с доплатами</a>
    <a href="#vybor">Не знаете, что выбрать? Два вопроса</a>
  </div>
</section>

<style>
  .services__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5.5rem); }
  .services__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; }
  .services__stage { position: relative; aspect-ratio: 4 / 5; max-height: 62vh; border-radius: 50% 50% var(--r-m) var(--r-m) / 30% 30% var(--r-m) var(--r-m); overflow: hidden; background: var(--nude); }
  .services__stage :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.45s var(--ease-out), transform 0.9s var(--ease-out); transform: scale(1.04); }
  .services__stage :global(img.is-active) { opacity: 1; transform: scale(1); }

  .services__list { border-top: 1px solid var(--line); counter-reset: svc; }
  .svc {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 2rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .svc > :global(picture) { display: none; }
  .svc__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem);
    font-weight: 620;
    line-height: 1;
    transition: color var(--dur-fast);
  }
  .svc.is-active .svc__name { color: var(--cherry); }
  .svc__tag {
    display: inline-block;
    vertical-align: 0.5em;
    margin-left: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--nude);
    color: var(--plum);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.3;
  }
  .svc__plain { margin-top: 0.6rem; max-width: 50ch; }
  .svc__includes { margin-top: 0.4rem; color: var(--ink-2); }
  .svc__meta { display: grid; justify-items: end; align-content: start; gap: 0.35rem; text-align: right; }
  .svc__price { font-size: var(--step-1); font-weight: 700; white-space: nowrap; }
  .svc__time { display: inline-flex; gap: 0.35rem; align-items: center; color: var(--ink-2); white-space: nowrap; }
  .svc__book { margin-top: 0.5rem; }

  .services__after { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 2rem; font-weight: 600; }
  .services__after a { padding-block: 0.6rem; }

  @media (max-width: 900px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__aside { position: static; }
    .services__stage { display: none; }
    .svc { grid-template-columns: 88px 1fr; gap: 0.25rem 1rem; padding-block: 1.25rem; }
    .svc > :global(picture) { display: block; grid-row: span 2; }
    .svc :global(.svc__thumb) { width: 88px; height: 112px; object-fit: cover; border-radius: var(--nail-oval); }
    .svc__meta { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1rem; justify-items: start; text-align: left; margin-top: 0.5rem; }
    .svc__book { margin-top: 0; margin-left: auto; }
  }
  @media (max-width: 420px) {
    .svc { grid-template-columns: 64px 1fr; }
    .svc :global(.svc__thumb) { width: 64px; height: 84px; }
    .svc__meta { grid-column: 1 / -1; }
  }
</style>

<script>
  // Desktop: the row under the pointer or keyboard focus shows its photo in the big frame.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-svc]')];
  const stage = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const activate = (id: string) => {
    rows.forEach((r) => r.classList.toggle('is-active', r.dataset.svc === id));
    stage.forEach((img) => img.classList.toggle('is-active', img.dataset.stage === id));
  };
  rows.forEach((row) => {
    row.addEventListener('pointerenter', () => activate(row.dataset.svc!));
    row.addEventListener('focusin', () => activate(row.dataset.svc!));
  });
</script>

---
import { withBase } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const links = nav.map((item) => ({ ...item, href: withBase(item.href) }));
---

<header class="header">
  <div class="container header__inner">
    <a href={withBase('/')} class="header__logo" aria-label="Лунка, на главную"><Logo /></a>

    <nav class="header__nav" aria-label="Основное меню">
      <ul class="header__links">
        {links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone num" href={site.phone.href}>{site.phone.display}</a>
      <a class="btn btn--primary btn--small header__cta" href={withBase('/#zapis')}>Записаться</a>
      <button class="header__menu" type="button" data-menu-open aria-haspopup="dialog">
        <Icon name="list" /><span>Меню</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" data-menu aria-label="Меню сайта">
  <div class="menu__top">
    <Logo />
    <button class="menu__close" type="button" data-menu-close>
      <Icon name="x" /><span class="visually-hidden">Закрыть меню</span>
    </button>
  </div>
  <nav aria-label="Меню сайта">
    <ul class="menu__links">
      {links.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
      <li><a href={withBase('/#vybor')} data-menu-link>Помочь с выбором</a></li>
    </ul>
  </nav>
  <div class="menu__bottom">
    <a class="btn btn--primary btn--block" href={withBase('/#zapis')} data-menu-link>Записаться</a>
    <a class="btn btn--ghost btn--block" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
    <p class="small muted">{site.hours}. Номер демонстрационный.</p>
  </div>
</dialog>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in oklab, var(--milk) 94%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
  }
  @supports (animation-timeline: scroll()) {
    .header { animation: header-edge linear both; animation-timeline: scroll(); animation-range: 0 80px; }
    @keyframes header-edge { to { border-bottom-color: var(--line); } }
  }
  .header__inner { display: flex; align-items: center; gap: 2rem; height: var(--header-h); }
  .header__logo { text-decoration: none; padding: 4px 2px; margin-left: -2px; }
  .header__nav { margin-left: auto; }
  .header__links { display: flex; gap: 1.75rem; }
  .header__links a {
    font-weight: 550;
    text-decoration: none;
    padding-block: 0.5rem;
    background: linear-gradient(var(--cherry), var(--cherry)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.25s var(--ease-out);
  }
  .header__links a:hover { background-size: 100% 2px; }
  .header__actions { display: flex; align-items: center; gap: 1rem; }
  .header__phone { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .header__phone:hover { text-decoration: underline; }

  .header__menu {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 1080px) {
    .header__nav, .header__phone { display: none; }
    .header__actions { margin-left: auto; gap: 0.5rem; }
    .header__menu { display: inline-flex; }
  }
  @media (max-width: 380px) {
    .header__cta { display: none; }
  }

  /* Mobile menu: a modal sheet, so focus stays inside and Escape closes it. */
  .menu {
    width: 100%;
    max-width: 460px;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0 var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
    display: none;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--milk);
  }
  .menu[open] { display: flex; }
  .menu__top { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); }
  .menu__close {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .menu__close :global(.icon) { width: 22px; height: 22px; }
  .menu__links a {
    display: block;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu__bottom { display: grid; gap: 0.75rem; margin-top: auto; }
</style>

<script>
  import { animate } from 'motion/mini';
  import { stagger } from 'motion';
  import { EASE, focusQuietly, prefersReducedMotion } from '../lib/motion';

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && openBtn) {
    openBtn.addEventListener('click', () => {
      menu.showModal();
      if (!prefersReducedMotion()) {
        animate(menu, { opacity: [0, 1], transform: ['translateX(24px)', 'translateX(0)'] }, { duration: 0.32, ease: EASE });
        animate(menu.querySelectorAll('.menu__links li'), { opacity: [0, 1], transform: ['translateX(16px)', 'translateX(0)'] }, { duration: 0.3, delay: stagger(0.035, { startDelay: 0.06 }), ease: EASE });
      }
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // Tapping the dimmed area outside the sheet closes it too.
    menu.addEventListener('click', (e) => {
      if (e.target === menu) menu.close();
    });
    menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) =>
      link.addEventListener('click', (e) => {
        const url = new URL(link.href);
        const target = url.pathname === location.pathname && url.hash ? document.querySelector<HTMLElement>(url.hash) : null;
        menu.close();
        if (!target) return;
        // Same-page anchor: move focus to the section, not back to the menu button.
        e.preventDefault();
        history.pushState(null, '', url.hash);
        target.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
        focusQuietly(target.querySelector<HTMLElement>('h2, h1') ?? target);
      }),
    );
  }
</script>

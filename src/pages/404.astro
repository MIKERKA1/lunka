---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="Страница не найдена" noindex>
  <section class="section">
    <div class="container nf">
      <h1 class="display">Такой страницы нет</h1>
      <p class="lead">Возможно, ссылка устарела или в адресе опечатка. Всё важное есть на главной: услуги, цены и запись.</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href={withBase('/#zapis')}>Записаться</a>
        <a class="btn btn--ghost" href={withBase('/')}>На главную</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 1.5rem; justify-items: start; min-height: 50vh; align-content: center; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
